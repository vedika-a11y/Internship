  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "649ca95a-dd1c-4880-997c-428ceec7c4a1",
   "metadata": {},
   "outputs": [],
   "source": [
    "le = LabelEncoder()\n",
    "\n",
    "df['Month'] = le.fit_transform(df['Month'])\n",
    "\n",
    "df['VisitorType'] = le.fit_transform(df['VisitorType'])\n",
    "\n",
    "df['Weekend'] = le.fit_transform(df['Weekend'])\n",
    "\n",
    "df['Revenue'] = le.fit_transform(df['Revenue'])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "2f1e3249-20b2-490c-9b3d-79d0c920bc04",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Dataset Division (80% & 20%)\n",
    "\n",
    "Divide the original dataset into 80% and 20% datasets as per requirement."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "7c411f16-9afb-40fb-aaa6-d5ed79e11bb3",
   "metadata": {},
   "outputs": [],
   "source": [
    "dataset80 , dataset20 = train_test_split(\n",
    "    df,\n",
    "    test_size=0.20,\n",
    "    random_state=42\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "1154eaad-d1d3-4673-8def-1d1819e1ae21",
   "metadata": {},
   "outputs": [
