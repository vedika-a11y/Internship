      "20 Percent Dataset Shape: (2466, 18)\n"
     ]
    }
   ],
   "source": [
    "print(\"80 Percent Dataset Shape:\",dataset80.shape)\n",
    "\n",
    "print(\"20 Percent Dataset Shape:\",dataset20.shape)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "76755333-c183-4409-84b9-745fc69b0875",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 80% Dataset Processing\n",
    "\n",
    "Separate features and target variable for the 80% dataset."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "210cb3f9-5a5a-4117-96dc-5aa6a21aa38c",
   "metadata": {},
   "outputs": [],
   "source": [
    "X80 = dataset80.drop('Revenue',axis=1)\n",
    "\n",
    "y80 = dataset80['Revenue']"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "5fe2b799-5fd7-42c6-bd03-9c23cf6af5af",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Train-Test Split (80%)\n",
    "\n",
    "Split the 80% dataset into training and testing data."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "bf692d52-763d-4fd2-97de-6082c9631258",
   "metadata": {},
   "outputs": [],
   "source": [
    "X80_train,X80_test,y80_train,y80_test = train_test_split(\n",
    "    X80,\n",
    "    y80,\n",
    "    test_size=0.20,\n",
    "    random_state=42\n",
    ")"
   ]
  },
